+
+// Ollama: ColBERT late-interaction encoding. The model-specific logic
+// (profile, projection sidecar, token plan, post-processing) lives in
+// llama/compat/server/server-ollama-colbert.cpp; this handler only does the
+// task plumbing that needs the private server types.
+std::unique_ptr<server_res_generator> server_routes::handle_colbert_impl(const server_http_req & req) {
+    auto res = create_response();
+    if (!params.embedding) {
+        res->error(format_error_response("This server does not support embeddings. Start it with `--embeddings`", ERROR_TYPE_NOT_SUPPORTED));
+        return res;
+    }
+    if (meta->pooling_type != LLAMA_POOLING_TYPE_NONE) {
+        res->error(format_error_response("ColBERT encoding requires pooling type 'none'", ERROR_TYPE_INVALID_REQUEST));
+        return res;
+    }
+
+    std::string err;
+    if (!ollama_colbert::ensure_init(ctx_server.model_tgt, err)) {
+        res->error(format_error_response(err, ERROR_TYPE_NOT_SUPPORTED));
+        return res;
+    }
+
+    const json body = json::parse(req.body);
+    std::vector<std::string> inputs;
+    bool is_query = false;
+    if (!ollama_colbert::parse_request(body, inputs, is_query, err)) {
+        res->error(format_error_response(err, ERROR_TYPE_INVALID_REQUEST));
+        return res;
+    }
+
+    std::vector<ollama_colbert::encode_plan> plans(inputs.size());
+    auto & rd = res->rd;
+    {
+        std::vector<server_task> tasks;
+        tasks.reserve(inputs.size());
+        for (size_t i = 0; i < inputs.size(); i++) {
+            if (!ollama_colbert::build_plan(ctx_server.vocab, inputs[i], is_query, plans[i], err)) {
+                res->error(format_error_response(err, ERROR_TYPE_INVALID_REQUEST));
+                return res;
+            }
+
+            server_task task = server_task(SERVER_TASK_TYPE_EMBEDDING);
+            task.id     = rd.get_new_id();
+            task.index  = i;
+            task.tokens = server_tokens(llama_tokens(plans[i].tokens.begin(), plans[i].tokens.end()), false);
+            task.params.res_type = TASK_RESPONSE_TYPE_NONE;
+            tasks.push_back(std::move(task));
+        }
+        rd.post_tasks(std::move(tasks));
+    }
+
+    auto all_results = rd.wait_for_all(req.should_stop);
+    if (all_results.is_terminated) {
+        return res; // connection is closed
+    }
+    if (all_results.error) {
+        res->error(all_results.error->to_json());
+        return res;
+    }
+
+    json data = json::array();
+    for (auto & result : all_results.results) {
+        auto * embd = dynamic_cast<server_task_result_embd *>(result.get());
+        GGML_ASSERT(embd != nullptr);
+        GGML_ASSERT(embd->index < plans.size());
+
+        json item;
+        if (!ollama_colbert::encode_response_item(plans[embd->index], embd->embedding, item, err)) {
+            res->error(format_error_response(err, ERROR_TYPE_SERVER));
+            return res;
+        }
+        item["index"]    = embd->index;
+        item["n_tokens"] = embd->n_tokens;
+        data.push_back(std::move(item));
+    }
+
+    res->ok(json{
+        {"object",     "list"},
+        {"input_type", is_query ? "query" : "document"},
+        {"dim",        ollama_colbert::output_dim()},
+        {"data",       std::move(data)},
+    });
+    return res;
+}
